# =============================================================================
# НАСТРОЙКИ ТЕЛЕГРАМ БОТА
# =============================================================================
TELEGRAM_BOT_TOKEN=your_bot_token_here

# =============================================================================
# НАСТРОЙКИ ПРОКСИ (для обхода блокировок)
# =============================================================================
# Если ваш прокси требует аутентификацию, используйте формат:
#   protocol://username:password@host:port
#
# ПОДДЕРЖИВАЕМЫЕ ПРОТОКОЛЫ:
#   - http://  - HTTP прокси
#   - socks5:// - SOCKS5 прокси (рекомендуется)
#   - socks4:// - SOCKS4 прокси
#
# ПРИМЕРЫ:
#   HTTP прокси без аутентификации:
#     TELEGRAM_PROXY_URL=http://123.45.67.89:8080
#
#   HTTP прокси с аутентификацией:
#     TELEGRAM_PROXY_URL=http://myuser:mypass@123.45.67.89:8080
#
#   SOCKS5 прокси (рекомендуется для Telegram):
#     TELEGRAM_PROXY_URL=socks5://myuser:mypass@123.45.67.89:1080
#
#   SOCKS5 без пароля:
#     TELEGRAM_PROXY_URL=socks5://123.45.67.89:1080
#
# Если прокси не нужен, оставьте пустым или закомментируйте:
# TELEGRAM_PROXY_URL=

# =============================================================================
# ДРУГИЕ НАСТРОЙКИ
# =============================================================================
SECRET_KEY=your_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_NAME=your_db_name
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# API Keys
DEEPSEEK_API_KEY=your_deepseek_api_key
YANDEX_SPEECHKIT_API_KEY=your_yandex_api_key

# Developer
DEVELOPER_CHAT_ID=your_chat_id

# Bot
BOT_USERNAME=your_bot_username

# Premium & Tokens
PREMIUM_PRICE_MONTH=199
PREMIUM_PRICE_YEAR=1999
TOKEN_PRICE_PER_UNIT=5
TOKEN_PACK_10=50
TOKEN_PACK_50=250
TOKEN_PACK_100=450
TOKEN_PACK_200=800
TOKEN_PACK_500=2000

# YoKassa (optional)
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# Cryptography
CRYPTOGRAPHY_KEY=your_crypto_key

# Logging
LOGGING_LEVEL=INFO
