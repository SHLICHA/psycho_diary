# =============================================================================
# НАСТРОЙКИ ТЕЛЕГРАМ БОТА
# =============================================================================
TELEGRAM_BOT_TOKEN=your_bot_token_here

# =============================================================================
# НАСТРОЙКИ ПРОКСИ (для обхода блокировок)
# =============================================================================
# Если ваш прокси требует аутентификацию, используйте формат:
#   protocol://username:password@host:port
#
# ПОДДЕРЖИВАЕМЫЕ ПРОТОКОЛЫ:
#   - http://  - HTTP прокси
#   - socks5:// - SOCKS5 прокси (рекомендуется)
#   - socks4:// - SOCKS4 прокси
#
# ПРИМЕРЫ:
#   HTTP прокси без аутентификации:
#     TELEGRAM_PROXY_URL=http://123.45.67.89:8080
#
#   HTTP прокси с аутентификацией:
#     TELEGRAM_PROXY_URL=http://myuser:mypass@123.45.67.89:8080
#
#   SOCKS5 прокси (рекомендуется для Telegram):
#     TELEGRAM_PROXY_URL=socks5://myuser:mypass@123.45.67.89:1080
#
#   SOCKS5 без пароля:
#     TELEGRAM_PROXY_URL=socks5://123.45.67.89:1080
#
# Если прокси не нужен, оставьте пустым или закомментируйте:
# TELEGRAM_PROXY_URL=

# =============================================================================
# ДРУГИЕ НАСТРОЙКИ
# =============================================================================
SECRET_KEY=your_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Для HTTPS за nginx (админка). Prod пример:
# CSRF_TRUSTED_ORIGINS=https://psychodiary.ru,https://www.psychodiary.ru
CSRF_TRUSTED_ORIGINS=

# Database
DATABASE_NAME=your_db_name
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# API Keys
DEEPSEEK_API_KEY=your_deepseek_api_key
YANDEX_SPEECHKIT_API_KEY=your_yandex_api_key

# Yandex Object Storage (для Long Running SpeechKit / длинных голосовых)
# Нужны для распознавания аудио > ~1 минуты (upload → SpeechKit).
YANDEX_STORAGE_BUCKET_NAME=your_bucket_name
YANDEX_STORAGE_ACCESS_KEY_ID=your_access_key_id
YANDEX_STORAGE_SECRET_ACCESS_KEY=your_secret_access_key
YANDEX_STORAGE_REGION=ru-central1
YANDEX_STORAGE_ENDPOINT=https://storage.yandexcloud.net

# Developer
DEVELOPER_CHAT_ID=your_chat_id
# MAX user id разработчика (admin/stats/feedbacks/broadcast в MAX без telegram_id)
DEVELOPER_MAX_USER_ID=

# Monitoring (безопасный доступ к /monitoring/*)
# Включить строгий режим доступа к мониторингу (true/false)
MONITORING_REQUIRE_PRIVILEGED=false
# Список внутренних user.id через запятую (пример: 1,42,77)
MONITORING_PRIVILEGED_USER_IDS=
# Временная обратная совместимость: разрешать legacy-проверку через DEVELOPER_CHAT_ID и telegram_id
MONITORING_ALLOW_LEGACY_TELEGRAM_ID=true

# Consumer web app base URL (session handoff from bots: /auth/telegram/?token=…, /auth/max/?token=…)
WEB_APP_URL=http://127.0.0.1:8000

# Transactional email (password reset + merge OTP when target has no messenger)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Psycho Diary <noreply@example.com>
# If EMAIL_HOST empty, emails are logged only (dev). Set true to raise on send failure in prod.
EMAIL_FAIL_SILENTLY=true

# Identity merge: explicit confirm flow при конфликте email (true/false)
# Если true, complete-registration вернет confirmation_token вместо прямой ошибки конфликта
EMAIL_MERGE_CONFIRMATION_ENABLED=false
# Разрешить web endpoint подтверждения merge как fallback (true/false).
# По умолчанию primary flow: Telegram/MAX callbacks (+ email OTP if target has no messenger).
EMAIL_MERGE_WEB_CONFIRM_FALLBACK_ENABLED=false
# После двустороннего confirm выполнять data-merge аккаунтов (true/false).
# Включать в prod только после зелёных merge-тестов на стейдже.
EMAIL_MERGE_EXECUTE_ENABLED=false

# =============================================================================
# Публичный домен (webhook MAX + ЮKassa)
# =============================================================================
# Пусто → локалка: MAX polling, payment webhook выключен (sync через API).
# Prod пример: https://www.psychodiary.ru
# Авто-URL:
#   {BOT_PUBLIC_DOMAIN}/api/max/webhook/
#   {BOT_PUBLIC_DOMAIN}/api/payments/webhook/
BOT_PUBLIC_DOMAIN=
# Явный URL оплаты (опционально; иначе из BOT_PUBLIC_DOMAIN).
PAYMENT_WEBHOOK_URL=

# =============================================================================
# VK MAX TRANSPORT (поэтапное включение)
# =============================================================================
# Включение отправки в MAX (true/false). До полной интеграции рекомендуется false.
MAX_TRANSPORT_ENABLED=false
# Режим MAX: пусто = auto (webhook если задан BOT_PUBLIC_DOMAIN или MAX_WEBHOOK_URL).
# Явно: polling | webhook
MAX_TRANSPORT_MODE=
# Токен бота VK MAX для Authorization заголовка.
MAX_BOT_TOKEN=
# Username бота в MAX (без @) для реферальных deep links: https://max.ru/<username>?start=...
MAX_BOT_USERNAME=
# Базовый URL API VK MAX.
MAX_API_BASE_URL=https://platform-api2.max.ru
# CA Минцифры для TLS к platform-api2.max.ru (через запятую).
# 1) intermediate: russian_trusted_sub_ca_2024_pem.crt
# 2) root:         russian_trusted_root_ca_pem.crt
MAX_API_CA_CERT_PATHS=russian_trusted_sub_ca_2024_pem.crt,russian_trusted_root_ca_pem.crt
# Таймаут HTTP-запросов к VK MAX API (в секундах).
MAX_API_TIMEOUT_SECONDS=10
# Секрет входящих webhook-запросов MAX (если используется).
MAX_WEBHOOK_SECRET=
# Явный URL MAX webhook (опционально; иначе из BOT_PUBLIC_DOMAIN).
MAX_WEBHOOK_URL=
# Таймаут long polling запроса к MAX /updates (секунды).
MAX_POLLING_TIMEOUT_SECONDS=30
# Пауза при пустом polling-ответе или ошибке (секунды).
MAX_POLLING_IDLE_SLEEP_SECONDS=0
# Лимит запросов к MAX API (token bucket): токенов в секунду.
MAX_RATE_LIMIT_RPS=10
# Burst для token bucket rate limiter MAX API.
MAX_RATE_LIMIT_BURST=50
# Максимальная длина одного сообщения перед chunking.
MAX_MESSAGE_MAX_LENGTH=3500
# TTL состояния MAX-пользователя в cache/Redis (секунды).
MAX_STATE_TTL_SECONDS=3600

# Bot
BOT_USERNAME=your_bot_username

# AI activity filter
# Количество дней неактивности после которого периодические ИИ-задачи пропускаются
AI_INACTIVITY_DAYS=30

# Premium & Tokens
PREMIUM_PRICE_MONTH=199
PREMIUM_PRICE_YEAR=1999
TOKEN_PRICE_PER_UNIT=5
TOKEN_PACK_10=50
TOKEN_PACK_50=250
TOKEN_PACK_100=450
TOKEN_PACK_200=800
TOKEN_PACK_500=2000

# YoKassa (платежи)
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key

# Cryptography
CRYPTOGRAPHY_KEY=your_crypto_key

# Logging
LOGGING_LEVEL=INFO
